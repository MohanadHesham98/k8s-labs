# Small Steps Environment Variables
# Copy this file to .env and update values for production

# JWT Secret (CHANGE THIS in production - use a long random string)
JWT_SECRET=smallsteps-super-secret-key-change-in-production-2026

# MongoDB Credentials
MONGO_USER=smallsteps
MONGO_PASS=smallsteps_pass
MONGODB_URI=mongodb://smallsteps:smallsteps_pass@mongo:27017/smallsteps

# Node.js
NODE_ENV=production
PORT=3000
